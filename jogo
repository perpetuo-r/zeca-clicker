TELA = pygame.display.set_mode((LARGURA, ALTURA))
pygame.display.set_caption("Fuga do Zeca GIGANTE!")
RELOGIO = pygame.time.Clock()
FPS = 60

# Cores
BRANCO = (255, 255, 255)
PRETO = (20, 22, 28)
ROXO_LORENA = (170, 75, 230)
PELE = (245, 195, 160)
CABELO_LORENA = (75, 42, 28)
MADEIRA = (185, 115, 60)
VERDE_TOPO = (75, 185, 95)
