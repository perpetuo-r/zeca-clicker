    pygame.draw.circle(z_surf, SKIN_COLOR, (cx, cy - int(48 * scale)), int(48 * scale))
    pygame.draw.ellipse(z_surf, (230, 180, 150), (cx - int(38 * scale), cy - int(24 * scale), int(76 * scale), int(30 * scale)))

