def format_num(n):
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.2f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return f"{int(n)}"


def calculate_claimable_diplomas(lifetime_points, current_diplomas):
    if lifetime_points < 25000:
        return 0
    total_earned = int(math.floor(math.sqrt(lifetime_points / 25000)))
    return max(0, total_earned - current_diplomas)


def main():
    global screen, SCREEN_WIDTH, SCREEN_HEIGHT, LEFT_PANEL_W, MID_PANEL_W, RIGHT_PANEL_W

    points = 0.0
    lifetime_points = 0.0
    diplomas = 0
    click_power_base = 1.0
    nps_base = 0.0

    upgrades = []
    def reset_upgrades():
        upgrades.clear()
        for u in UPGRADES_TEMPLATE:
            item = u.copy()
            item["count"] = 0
            item["cost"] = item["base_cost"]
            upgrades.append(item)

    reset_upgrades()

    floating_texts = []
    zeca_cx = LEFT_PANEL_W // 2
    zeca_cy = SCREEN_HEIGHT // 2 + 30
    target_scale = 1.0
    current_scale = 1.0

    store_scroll_y = 0
    mid_scroll_y = 0
    anim_tick = 0

    # Variáveis da janela de inserção numérica (tecla 6)
    input_modal_active = False
    input_text = ""

    running = True
    while running:
        dt = clock.tick(60) / 1000.0
        anim_tick += 1

        prestige_multiplier = 1.0 + (diplomas * 0.10)
        current_nps = nps_base * prestige_multiplier
        current_click = click_power_base * prestige_multiplier

        if current_nps > 0:
            gained = current_nps * dt
            points += gained
            lifetime_points += gained

        current_scale += (target_scale - current_scale) * 0.25
        if target_scale != 1.0 and abs(current_scale - target_scale) < 0.02:
            target_scale = 1.0

        claimable = calculate_claimable_diplomas(lifetime_points, diplomas)
        mouse_pos = pygame.mouse.get_pos()

        # --- Eventos ---
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            elif event.type == pygame.KEYDOWN:
                # Se a janela de entrada estiver ativa
                if input_modal_active:
                    if event.key == pygame.K_RETURN or event.key == pygame.K_KP_ENTER:
                        if input_text.isdigit():
                            new_val = float(input_text)
                            diff = new_val - points
                            points = new_val
                            if diff > 0:
                                lifetime_points += diff
                        input_modal_active = False
                        input_text = ""
                    elif event.key == pygame.K_ESCAPE:
                        input_modal_active = False
                        input_text = ""
                    elif event.key == pygame.K_BACKSPACE:
                        input_text = input_text[:-1]
                    elif event.unicode.isdigit() and len(input_text) < 15:
                        input_text += event.unicode
                    continue

                # Alternar tela cheia com F11
                if event.key == pygame.K_F11:
                    pygame.display.toggle_fullscreen()

                # Fechar com ESC quando fora do modal
                elif event.key == pygame.K_ESCAPE:
                    running = False

                # Acionamento da seleção de notas com a tecla 6
                elif event.key == pygame.K_6 or event.key == pygame.K_KP6:
                    input_modal_active = True
                    input_text = str(int(points))

            elif event.type == pygame.MOUSEWHEEL and not input_modal_active:
                mx, my = mouse_pos
                if LEFT_PANEL_W <= mx < LEFT_PANEL_W + MID_PANEL_W:
                    mid_scroll_y = max(min(0, mid_scroll_y + event.y * 30), -300)
                elif mx >= LEFT_PANEL_W + MID_PANEL_W:
                    store_scroll_y = max(min(0, store_scroll_y + event.y * 30), -350)

            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1 and not input_modal_active:
                mx, my = event.pos

                # 1. Clique no Zeca
                if mx < LEFT_PANEL_W:
                    dist = math.hypot(mx - zeca_cx, my - zeca_cy)
                    if dist <= 135:
                        points += current_click
                        lifetime_points += current_click
                        target_scale = 0.88
                        floating_texts.append(FloatingText(mx, my, f"+{int(current_click)} Nota"))

                # 2. Formatura
                prestige_btn = pygame.Rect(LEFT_PANEL_W + 20, 15, MID_PANEL_W - 40, 54)
                if prestige_btn.collidepoint(mx, my) and claimable > 0:
                    diplomas += claimable
                    points = 0.0
                    click_power_base = 1.0
                    nps_base = 0.0
                    reset_upgrades()
                    floating_texts.append(FloatingText(mx, my, f"Formatura! +{claimable} Diplomas!", PURPLE))

                # 3. Loja de Upgrades
                if mx >= LEFT_PANEL_W + MID_PANEL_W:
                    item_y = 75 + store_scroll_y
                    for up in upgrades:
                        btn_rect = pygame.Rect(LEFT_PANEL_W + MID_PANEL_W + 15, item_y, RIGHT_PANEL_W - 30, 72)
                        if btn_rect.collidepoint(mx, my):
                            if points >= up["cost"]:
                                points -= up["cost"]
                                up["count"] += 1
                                nps_base += up["nps"]
                                click_power_base += up["click_bonus"]
                                up["cost"] = int(up["cost"] * 1.15)
                                floating_texts.append(FloatingText(mx - 80, my, "Comprado!", GREEN))
                        item_y += 80

        for ft in floating_texts:
            ft.update()
        floating_texts = [ft for ft in floating_texts if ft.lifetime > 0]

        # ==========================================
        # RENDERIZAÇÃO
        # ==========================================

        # --- PAINEL 1: ZECA E SALA DE AULA ---
        p1_rect = pygame.Rect(0, 0, LEFT_PANEL_W, SCREEN_HEIGHT)
        pygame.draw.rect(screen, BOARD_DARK, p1_rect)
        pygame.draw.rect(screen, BOARD_FRAME, p1_rect, 10)

        pts_txt = FONT_TITLE.render(f"{format_num(points)} Notas", True, GOLD)
        nps_txt = FONT_MD.render(f"{current_nps:.1f} notas/seg", True, (210, 230, 220))
        clk_txt = FONT_SM.render(f"+{int(current_click)} por clique", True, (170, 200, 190))

        screen.blit(pts_txt, (LEFT_PANEL_W // 2 - pts_txt.get_width() // 2, int(SCREEN_HEIGHT * 0.06)))
        screen.blit(nps_txt, (LEFT_PANEL_W // 2 - nps_txt.get_width() // 2, int(SCREEN_HEIGHT * 0.12)))
        screen.blit(clk_txt, (LEFT_PANEL_W // 2 - clk_txt.get_width() // 2, int(SCREEN_HEIGHT * 0.155)))

        draw_professor_zeca(screen, zeca_cx, zeca_cy, scale=current_scale)

        hint = FONT_SM.render("Clique no Prof. Zeca!", True, (160, 190, 180))
        screen.blit(hint, (LEFT_PANEL_W // 2 - hint.get_width() // 2, SCREEN_HEIGHT - 45))

        # --- PAINEL 2: MURAL VISUAL DA ESCOLA ---
        p2_rect = pygame.Rect(LEFT_PANEL_W, 0, MID_PANEL_W, SCREEN_HEIGHT)
        pygame.draw.rect(screen, MID_BG, p2_rect)
        pygame.draw.line(screen, (20, 30, 25), (LEFT_PANEL_W, 0), (LEFT_PANEL_W, SCREEN_HEIGHT), 3)
        pygame.draw.line(screen, (20, 30, 25), (LEFT_PANEL_W + MID_PANEL_W, 0), (LEFT_PANEL_W + MID_PANEL_W, SCREEN_HEIGHT), 3)

        prestige_btn = pygame.Rect(LEFT_PANEL_W + 15, 15, MID_PANEL_W - 30, 54)
        if claimable > 0:
            pygame.draw.rect(screen, PURPLE, prestige_btn, border_radius=8)
            p_title = FONT_MD.render(f"🎓 FORMATURA! (+{claimable} Diplomas)", True, WHITE)
            p_sub = FONT_XS.render(f"Resetar por +{claimable * 10}% permanente", True, (240, 220, 255))
        else:
            pygame.draw.rect(screen, (50, 68, 60), prestige_btn, border_radius=8)
            p_title = FONT_MD.render("🎓 FORMATURA (Bloqueado)", True, (160, 180, 170))
            needed = max(0, 25000 - int(lifetime_points))
            p_sub = FONT_XS.render(f"Faltam {format_num(needed)} notas para novo diploma", True, (130, 150, 140))

        screen.blit(p_title, (prestige_btn.x + 12, prestige_btn.y + 8))
        screen.blit(p_sub, (prestige_btn.x + 12, prestige_btn.y + 32))

        dip_txt = FONT_SM.render(f"Diplomas: {diplomas} (Bônus: +{int((prestige_multiplier - 1.0) * 100)}%)", True, GOLD)
        screen.blit(dip_txt, (LEFT_PANEL_W + 20, 78))

        row_y = 108 + mid_scroll_y
        for up in upgrades:
            row_rect = pygame.Rect(LEFT_PANEL_W + 10, row_y, MID_PANEL_W - 20, 76)
            pygame.draw.rect(screen, (32, 46, 38), row_rect, border_radius=6)
            pygame.draw.rect(screen, (45, 62, 52), row_rect, 1, border_radius=6)

            row_header = FONT_SM.render(f"{up['name']} ({up['count']})", True, (220, 235, 225))
            screen.blit(row_header, (row_rect.x + 12, row_rect.y + 6))

            if up["count"] == 0:
                empty_lbl = FONT_XS.render("Nenhum adquirido ainda...", True, (100, 125, 115))
                screen.blit(empty_lbl, (row_rect.x + 14, row_rect.y + 38))
            else:
                max_visible = max(6, (MID_PANEL_W - 80) // 38)
                items_to_draw = min(up["count"], max_visible)
                item_x = row_rect.x + 14
                for i in range(items_to_draw):
                    draw_visual_item(screen, up["icon"], item_x, row_rect.y + 32, anim_tick)
                    item_x += 38

                if up["count"] > max_visible:
                    more_lbl = FONT_SM.render(f"+{up['count'] - max_visible}", True, GOLD)
                    screen.blit(more_lbl, (row_rect.right - 45, row_rect.y + 38))

            row_y += 84

        # --- PAINEL 3: SECRETARIA E LOJA ---
        p3_rect = pygame.Rect(LEFT_PANEL_W + MID_PANEL_W, 0, RIGHT_PANEL_W, SCREEN_HEIGHT)
        pygame.draw.rect(screen, SIDEBAR_BG, p3_rect)

        store_title_surf = pygame.Surface((RIGHT_PANEL_W, 64))
        store_title_surf.fill((225, 230, 235))
        st_title = FONT_LG.render("Secretaria & Cantina", True, TEXT_DARK)
        store_title_surf.blit(st_title, (18, 18))
        screen.blit(store_title_surf, (LEFT_PANEL_W + MID_PANEL_W, 0))

        card_y = 75 + store_scroll_y
        for up in upgrades:
            card_rect = pygame.Rect(LEFT_PANEL_W + MID_PANEL_W + 15, card_y, RIGHT_PANEL_W - 30, 72)
            can_buy = points >= up["cost"]
            is_hover = card_rect.collidepoint(mouse_pos)

            bg = CARD_HOVER if (can_buy and is_hover) else (CARD_BG if can_buy else CARD_LOCKED)
            pygame.draw.rect(screen, bg, card_rect, border_radius=8)
            pygame.draw.rect(screen, (205, 210, 215), card_rect, 1, border_radius=8)

            name_lbl = FONT_MD.render(up["name"], True, TEXT_DARK if can_buy else TEXT_MUTED)
            desc_lbl = FONT_XS.render(up["desc"], True, TEXT_MUTED)
            screen.blit(name_lbl, (card_rect.x + 12, card_rect.y + 8))
            screen.blit(desc_lbl, (card_rect.x + 12, card_rect.y + 32))

            stats_str = ""
            if up["nps"] > 0:
                stats_str += f"+{up['nps'] * prestige_multiplier:.1f}/s "
            if up["click_bonus"] > 0:
                stats_str += f"+{int(up['click_bonus'] * prestige_multiplier)} clique"
            stats_lbl = FONT_SM.render(stats_str, True, GREEN if can_buy else TEXT_MUTED)
            screen.blit(stats_lbl, (card_rect.x + 12, card_rect.y + 49))

            cost_lbl = FONT_MD.render(f"{format_num(up['cost'])} 🪙", True, (180, 130, 20) if can_buy else RED)
            screen.blit(cost_lbl, (card_rect.right - cost_lbl.get_width() - 12, card_rect.y + 10))

            count_lbl = FONT_LG.render(str(up["count"]), True, (160, 175, 185))
            screen.blit(count_lbl, (card_rect.right - count_lbl.get_width() - 14, card_rect.y + 36))

            card_y += 80

        for ft in floating_texts:
            ft.draw(screen)

        # --- Janela de entrada discreta (tecla 6) ---
        if input_modal_active:
            overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
            overlay.fill((0, 0, 0, 140))
            screen.blit(overlay, (0, 0))

            box_w = 340
            box_h = 130
            box_rect = pygame.Rect(SCREEN_WIDTH // 2 - box_w // 2, SCREEN_HEIGHT // 2 - box_h // 2, box_w, box_h)
            pygame.draw.rect(screen, (34, 47, 62), box_rect, border_radius=8)
            pygame.draw.rect(screen, (52, 73, 94), box_rect, 2, border_radius=8)

            t_val = FONT_SM.render("Definir Total de Notas:", True, WHITE)
            screen.blit(t_val, (box_rect.x + 20, box_rect.y + 18))

            field_rect = pygame.Rect(box_rect.x + 20, box_rect.y + 45, box_w - 40, 36)
            pygame.draw.rect(screen, (20, 28, 38), field_rect, border_radius=5)
            pygame.draw.rect(screen, GOLD if (anim_tick // 30) % 2 == 0 else (100, 110, 120), field_rect, 1, border_radius=5)

            display_input = input_text + ("|" if (anim_tick // 25) % 2 == 0 else "")
            val_txt = FONT_MD.render(display_input, True, GOLD)
            screen.blit(val_txt, (field_rect.x + 10, field_rect.y + 7))

            sub_hint = FONT_XS.render("[Enter] Confirmar  |  [Esc] Cancelar", True, (150, 165, 175))
            screen.blit(sub_hint, (box_rect.x + 20, box_rect.y + 95))

        pygame.display.flip()

    pygame.quit()
    sys.exit()


