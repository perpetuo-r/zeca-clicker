FONTE_TITULO = pygame.font.SysFont("Arial", 46, bold=True)
FONTE_MEDIA = pygame.font.SysFont("Arial", 22, bold=True)
FONTE_PEQUENA = pygame.font.SysFont("Arial", 16, bold=True)

GRAVIDADE = 0.68

def carregar_foto_zeca(tam):
    # Aceita zeca.png ou zeca.jpg
    caminho = "zeca.png" if os.path.exists("zeca.png") else ("zeca.jpg" if os.path.exists("zeca.jpg") else None)
    if not caminho:
        return None
    try:
        img = pygame.image.load(caminho).convert_alpha()
        img = pygame.transform.smoothscale(img, (tam, tam))
        mascara = pygame.Surface((tam, tam), pygame.SRCALPHA)
        pygame.draw.circle(mascara, (255, 255, 255), (tam // 2, tam // 2), tam // 2)
        saida = pygame.Surface((tam, tam), pygame.SRCALPHA)
        saida.blit(img, (0, 0))
        saida.blit(mascara, (0, 0), special_flags=pygame.BLEND_RGBA_MIN)
        return saida
    except Exception:
        return None

FOTO_ZECA_GIGANTE = carregar_foto_zeca(110)


class ParticulaPasso:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.vx = random.uniform(-4, 4)
        self.vy = random.uniform(-6, -2)
        self.vida = 25

    def atualizar(self):
        self.x += self.vx
        self.y += self.vy
        self.vy += 0.3
        self.vida -= 1

    def desenhar(self, tela, cam_x):
        if self.vida > 0:
            pygame.draw.circle(tela, (140, 130, 120), (int(self.x - cam_x), int(self.y)), max(1, self.vida // 5))


class ReguaGigante:
    def __init__(self, x, y, vel_x, rotativa=False):
        self.x = float(x)
        self.y = float(y)
        self.vel_x = vel_x
        self.rotativa = rotativa
        self.angulo = 0
        self.rect = pygame.Rect(int(x), int(y), 65, 16)
        self.ativo = True

    def atualizar(self):
        self.x += self.vel_x
        if self.rotativa:
            self.angulo += 8
            self.y += math.sin(self.angulo * 0.05) * 2
        self.rect.x = int(self.x)
        self.rect.y = int(self.y)

        if self.rect.right < -200:
            self.ativo = False

    def desenhar(self, tela, cam_x):
        rx = self.rect.x - cam_x
        ry = self.rect.y
        base = pygame.Surface((65, 16), pygame.SRCALPHA)
        pygame.draw.rect(base, MADEIRA, (0, 0, 65, 16), border_radius=4)
        for i in range(8, 65, 10):
            pygame.draw.line(base, PRETO, (i, 0), (i, 7), 2)

        if self.rotativa:
            rot = pygame.transform.rotate(base, self.angulo)
            tela.blit(rot, (rx - rot.get_width() // 2 + 32, ry - rot.get_height() // 2 + 8))
        else:
            tela.blit(base, (rx, ry))


class Plataforma:
    def __init__(self, x, y, largura, tipo="normal"):
        self.rect = pygame.Rect(x, y, largura, 40)
        self.tipo = tipo  # 'normal', 'vertical_movel', 'horizontal_movel'
        self.y_inicial = y
        self.x_inicial = x
        self.tempo_movimento = random.uniform(0, 10)
        
        # Elementos extras na plataforma
        self.tem_mola = random.random() < 0.28 and largura > 180 and tipo == "normal"
        self.mola_rect = pygame.Rect(x + largura // 2 - 16, y - 12, 32, 12) if self.tem_mola else None
        
        self.tem_caderno = random.random() < 0.35 and not self.tem_mola
        self.caderno_rect = pygame.Rect(x + largura // 2 - 12, y - 28, 24, 20) if self.tem_caderno else None
        self.caderno_coletado = False

    def atualizar(self):
        self.tempo_movimento += 0.04
        if self.tipo == "vertical_movel":
            self.rect.y = int(self.y_inicial + math.sin(self.tempo_movimento) * 55)
        elif self.tipo == "horizontal_movel":
            self.rect.x = int(self.x_inicial + math.cos(self.tempo_movimento) * 70)

        if self.tem_mola:
            self.mola_rect.x = self.rect.x + self.rect.width // 2 - 16
            self.mola_rect.y = self.rect.y - 12

        if self.tem_caderno and not self.caderno_coletado:
            self.caderno_rect.x = self.rect.x + self.rect.width // 2 - 12
            self.caderno_rect.y = self.rect.y - 28 + int(math.sin(self.tempo_movimento * 2) * 4)

    def desenhar(self, tela, cam_x):
        rx = self.rect.x - cam_x
        ry = self.rect.y
        w, h = self.rect.width, self.rect.height

        # Bloco de terra / base
        pygame.draw.rect(tela, TERRA, (rx, ry, w, h), border_bottom_left_radius=6, border_bottom_right_radius=6)
        # Topo de grama
        pygame.draw.rect(tela, VERDE_TOPO, (rx, ry, w, 10), border_top_left_radius=6, border_top_right_radius=6)
        # Detalhes de textura (tijolos/pedras)
        for i in range(15, w - 15, 45):
            pygame.draw.rect(tela, (65, 52, 45), (rx + i, ry + 16, 24, 8), border_radius=2)

        # Mola / Trampolim
        if self.tem_mola:
            mx = self.mola_rect.x - cam_x
            my = self.mola_rect.y
            pygame.draw.rect(tela, PRETO, (mx - 2, my + 8, 36, 4))
            pygame.draw.rect(tela, AZUL_MOLA, (mx, my, 32, 8), border_radius=3)
            pygame.draw.line(tela, BRANCO, (mx + 4, my + 4), (mx + 28, my + 4), 2)

        # Caderno Colecionável
        if self.tem_caderno and not self.caderno_coletado:
            cx = self.caderno_rect.x - cam_x
            cy = self.caderno_rect.y
            pygame.draw.rect(tela, AMARELO_OURO, (cx, cy, 24, 20), border_radius=3)
            pygame.draw.rect(tela, BRANCO, (cx + 3, cy + 3, 18, 14))
            pygame.draw.line(tela, PRETO, (cx + 6, cy + 8), (cx + 18, cy + 8), 2)
            pygame.draw.line(tela, PRETO, (cx + 6, cy + 12), (cx + 15, cy + 12), 2)


class Lorena:
    def __init__(self, x, y):
        self.rect = pygame.Rect(x, y, 34, 62)
        self.vel_x = 0
        self.vel_y = 0
        self.no_chao = False
        self.pulos_restantes = 2

    def pular(self, forca=-14.2):
        self.vel_y = forca
        self.pulos_restantes -= 1
        self.no_chao = False

    def atualizar(self, plataformas):
        teclas = pygame.key.get_pressed()
        
        vel_base = 5.6
        if teclas[pygame.K_LEFT] or teclas[pygame.K_a]:
            self.vel_x = -3.2
        elif teclas[pygame.K_RIGHT] or teclas[pygame.K_d]:
            self.vel_x = 3.8
        else:
            self.vel_x = 0

        self.vel_y += GRAVIDADE
        self.rect.x += int(vel_base + self.vel_x)
        self.rect.y += int(self.vel_y)

        self.no_chao = False
        for plat in plataformas:
            # Pouso na plataforma
            if (self.vel_y >= 0 and
                self.rect.bottom >= plat.rect.top and
                self.rect.bottom <= plat.rect.top + 20 and
                self.rect.right > plat.rect.left and
                self.rect.left < plat.rect.right):
                self.rect.bottom = plat.rect.top
                self.vel_y = 0
                self.no_chao = True
                self.pulos_restantes = 2

                # Se a plataforma for móvel horizontalmente, leva o jogador junto
                if plat.tipo == "horizontal_movel":
                    self.rect.x += int(math.cos(plat.tempo_movimento) * 1.5)

            # Acionou a mola/trampolim
            if plat.tem_mola and self.rect.colliderect(plat.mola_rect) and self.vel_y >= 0:
                self.pular(forca=-19.5)  # Super pulo!

    def desenhar(self, tela, cam_x):
        rx = self.rect.x - cam_x
        ry = self.rect.y

        # Corpo / Roupa roxa
        pygame.draw.rect(tela, ROXO_LORENA, (rx + 4, ry + 24, 26, 38), border_radius=6)
        # Cabeça
        pygame.draw.circle(tela, PELE, (rx + 17, ry + 13), 13)
        # Cabelo comprido castanho
        pygame.draw.circle(tela, CABELO_LORENA, (rx + 17, ry + 9), 14)
        pygame.draw.rect(tela, CABELO_LORENA, (rx + 4, ry + 12, 10, 28), border_radius=4)
        # Mochila vermelha
        pygame.draw.rect(tela, (230, 80, 60), (rx - 3, ry + 26, 8, 22), border_radius=3)
        # Olho
        pygame.draw.circle(tela, PRETO, (rx + 22, ry + 14), 2)


class ZecaTitã:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)
        # Dimensões GIGANTES
        self.largura = 150
        self.altura = 230
        self.cooldown_ataque = 120
        self.passo_timer = 0

    def atualizar(self, lorena_x, lorena_y, reguas, particulas):
        distancia = lorena_x - self.x
        velocidade = 5.1 + (distancia * 0.0028)
        self.x += velocidade

        # O Zeca corre pesado, acompanhando a altura
        self.y += (lorena_y - self.y - 100) * 0.05
        self.passo_timer += 1

        # Tremores e partículas a cada pisada do Titã
        screen_shake = 0
        if self.passo_timer % 32 == 0:
            screen_shake = 7
            for _ in range(5):
                particulas.append(ParticulaPasso(self.x + self.largura - 20, self.y + self.altura))

        # Padrão de ataque com réguas
        self.cooldown_ataque -= 1
        if self.cooldown_ataque <= 0:
            self.cooldown_ataque = random.randint(110, 170)
            tipo_rotativa = random.random() < 0.45
            altura_tiro = self.y + 40 if tipo_rotativa else self.y + 110
            reguas.append(ReguaGigante(self.x + self.largura + 10, altura_tiro, 12.5, rotativa=tipo_rotativa))

        return screen_shake

    def get_rect(self):
        return pygame.Rect(int(self.x), int(self.y), self.largura, self.altura)

    def desenhar(self, tela, cam_x):
        rx = int(self.x - cam_x)
        ry = int(self.y)

        # Corpo colossal
        pygame.draw.rect(tela, (225, 225, 235), (rx, ry + 80, self.largura, self.altura - 80), border_radius=16)
        # Faixa / cinto preto do Zeca
        pygame.draw.rect(tela, PRETO, (rx + 8, ry + 155, self.largura - 16, 16))
        # Braço enorme segurando régua de metro
        pygame.draw.rect(tela, PELE, (rx + self.largura - 20, ry + 100, 36, 75), border_radius=10)
        pygame.draw.rect(tela, MADEIRA, (rx + self.largura + 10, ry + 60, 18, 140), border_radius=4)

        # Cabeça: Foto do Zeca Gigante ou Caricatura Procedural
        centro_x = rx + self.largura // 2 - 10
        if FOTO_ZECA_GIGANTE:
            tela.blit(FOTO_ZECA_GIGANTE, (centro_x - 55, ry - 35))
        else:
            pygame.draw.circle(tela, PELE, (centro_x, ry + 35), 45)
            # Óculos escuros gigantes
            pygame.draw.rect(tela, PRETO, (centro_x - 30, ry + 18, 60, 22), border_radius=4)
            # Barba/cavanhaque
            pygame.draw.arc(tela, (40, 28, 22), (centro_x - 25, ry + 35, 50, 35), 3.14, 0, 7)


def gerar_plataforma_elaborada(ultima_plat):
    distancia = random.randint(110, 210)
    largura = random.randint(180, 400)
    
    variacao_y = random.choice([-80, -45, 0, 45, 75])
    novo_y = max(240, min(ALTURA - 95, ultima_plat.rect.y + variacao_y))
    novo_x = ultima_plat.rect.right + distancia

    # Sorteia tipo de mecânica
    chance = random.random()
    if chance < 0.20:
        tipo = "vertical_movel"
    elif chance < 0.40:
        tipo = "horizontal_movel"
    else:
        tipo = "normal"

    return Plataforma(novo_x, novo_y, largura, tipo)


def main():
    lorena = Lorena(280, 340)
    zeca_gigante = ZecaTitã(-80, 220)

    # Plataformas iniciais
    plataformas = [
        Plataforma(0, 450, 600, "normal"),
        Plataforma(690, 420, 320, "vertical_movel"),
        Plataforma(1100, 370, 350, "normal"),
    ]

    reguas = []
    particulas = []
    pontuacao = 0
    cadernos_coletados = 0
    game_over = False
    motivo = ""
    shake_restante = 0

    rodando = True
    while rodando:
        RELOGIO.tick(FPS)

        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            elif evento.type == pygame.KEYDOWN:
                if not game_over:
                    if evento.key in (pygame.K_SPACE, pygame.K_UP, pygame.K_w):
                        if lorena.pulos_restantes > 0:
                            lorena.pular()
                else:
                    if evento.key == pygame.K_r:
                        main()
                        return

        if not game_over:
            lorena.atualizar(plataformas)
            tremor = zeca_gigante.atualizar(lorena.rect.x, lorena.rect.y, reguas, particulas)
            if tremor > 0:
                shake_restante = tremor

            # Atualiza plataformas móveis e colecionáveis
            for p in plataformas:
                p.atualizar()
                if p.tem_caderno and not p.caderno_coletado and lorena.rect.colliderect(p.caderno_rect):
                    p.caderno_coletado = True
                    cadernos_coletados += 1

            # Câmera centrada na Lorena
            cam_x = lorena.rect.x - 240

            # Geração procedural
            while plataformas[-1].rect.right - cam_x < LARGURA + 500:
                plataformas.append(gerar_plataforma_elaborada(plataformas[-1]))

            plataformas = [p for p in plataformas if p.rect.right - cam_x > -300]

            # Atualiza réguas e partículas
            for r in reguas[:]:
                r.atualizar()
                if not r.ativo:
                    reguas.remove(r)
                elif r.rect.colliderect(lorena.rect):
                    game_over = True
                    motivo = "Atingida em cheio pela régua do Zeca Gigante!"

            for part in particulas[:]:
                part.atualizar()
                if part.vida <= 0:
                    particulas.remove(part)

            pontuacao = int((lorena.rect.x - 280) / 10) + (cadernos_coletados * 100)

            # Colisão direta com o Titã
            if zeca_gigante.x + zeca_gigante.largura >= lorena.rect.left + 5:
                game_over = True
                motivo = "O Titã Zeca te engoliu na prova de recuperação!"

            if lorena.rect.top > ALTURA + 60:
                game_over = True
                motivo = "Você caiu no abismo!"
        else:
            cam_x = lorena.rect.x - 240

        # Aplica Screen Shake
        offset_y = random.randint(-shake_restante, shake_restante) if shake_restante > 0 else 0
        if shake_restante > 0:
            shake_restante -= 1

        # --- Renderização ---
        superficie_render = pygame.Surface((LARGURA, ALTURA))
        superficie_render.fill(AZUL_NOITE)

        # Fundo: réguas e equações em parallax
        for i in range(-1, 9):
            bx = int((i * 240) - (cam_x * 0.15) % 240)
            pygame.draw.line(superficie_render, (38, 44, 65), (bx, 0), (bx, ALTURA), 2)

        # Desenho das plataformas elaboradas
        for plat in plataformas:
            plat.desenhar(superficie_render, cam_x)

        # Partículas
        for part in particulas:
            part.desenhar(superficie_render, cam_x)

        # Projéteis
        for r in reguas:
            r.desenhar(superficie_render, cam_x)

        # Titã e Lorena
        zeca_gigante.desenhar(superficie_render, cam_x)
        lorena.desenhar(superficie_render, cam_x)

        # Blit na tela principal com o efeito de tremor
        TELA.blit(superficie_render, (0, offset_y))

        # --- HUD Superior ---
        pygame.draw.rect(TELA, (15, 18, 25), (0, 0, LARGURA, 54))
        distancia_zeca = max(0, int((lorena.rect.x - (zeca_gigante.x + zeca_gigante.largura)) / 10))

        txt_pontos = FONTE_MEDIA.render(f"Distância: {pontuacao}m", True, AMARELO_OURO)
        txt_cadernos = FONTE_PEQUENA.render(f"Cadernos (+100m): {cadernos_coletados}", True, (240, 240, 255))
        txt_alerta = FONTE_PEQUENA.render(f"DISTÂNCIA DO TITÃ: {distancia_zeca}m", True, VERMELHO_PERIGO if distancia_zeca < 20 else BRANCO)
        txt_pulos = FONTE_PEQUENA.render(f"Pulos: {lorena.pulos_restantes}/2", True, BRANCO)

        TELA.blit(txt_pontos, (25, 14))
        TELA.blit(txt_cadernos, (240, 17))
        TELA.blit(txt_alerta, (520, 17))
        TELA.blit(txt_pulos, (LARGURA - 130, 17))

        # Tela de Fim de Jogo
        if game_over:
            sombra = pygame.Surface((LARGURA, ALTURA), pygame.SRCALPHA)
            sombra.fill((0, 0, 0, 185))
            TELA.blit(sombra, (0, 0))

            t1 = FONTE_TITULO.render("RECUPERAÇÃO ETERNA!", True, VERMELHO_PERIGO)
            t2 = FONTE_MEDIA.render(motivo, True, BRANCO)
            t3 = FONTE_MEDIA.render(f"Pontuação Máxima: {pontuacao}m", True, AMARELO_OURO)
            t4 = FONTE_PEQUENA.render("Pressione [R] para reiniciar a fuga", True, BRANCO)

            TELA.blit(t1, (LARGURA // 2 - t1.get_width() // 2, 160))
            TELA.blit(t2, (LARGURA // 2 - t2.get_width() // 2, 235))
            TELA.blit(t3, (LARGURA // 2 - t3.get_width() // 2, 285))
            TELA.blit(t4, (LARGURA // 2 - t4.get_width() // 2, 345))

        pygame.display.flip()

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
