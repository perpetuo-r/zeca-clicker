    pygame.draw.ellipse(z_surf, (70, 40, 15), (cx - int(24 * scale), cy - int(34 * scale), int(48 * scale), int(16 * scale)))

    badge_rect = pygame.Rect(cx - int(66 * scale), cy - int(8 * scale), int(36 * scale), int(22 * scale))
