class FloatingText:
    def __init__(self, x, y, text, color=GOLD):
        self.x = x + random.randint(-15, 15)
        self.y = y + random.randint(-8, 8)
        self.text = text
        self.color = color
        self.alpha = 255
        self.lifetime = 45

    def update(self):
        self.y -= 1.3
        self.lifetime -= 1
        self.alpha = max(0, int((self.lifetime / 45) * 255))

    def draw(self, surface):
        if self.lifetime > 0:
            rendered = FONT_MD.render(self.text, True, self.color)
            surf = rendered.copy()
            surf.set_alpha(self.alpha)
            surface.blit(surf, (self.x, self.y))


def draw_professor_zeca(surface, center_x, center_y, scale=1.0):
